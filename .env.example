# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose. Used by the admin to create staff accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set to "false" to stop new companies signing up on their own
ALLOW_COMPANY_SIGNUP=true
# Serengeti Labs owner console (/owner): comma-separated emails allowed in
OWNER_EMAILS=you@serengetilabs.co.tz
# Marketing page (/): your public address and the WhatsApp number for "Message us on WhatsApp"
NEXT_PUBLIC_SITE_URL=https://www.shehenacargo.co.tz
NEXT_PUBLIC_SALES_WHATSAPP=255712000000
